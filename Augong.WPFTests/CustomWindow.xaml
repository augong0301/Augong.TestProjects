<Window x:Class="Augong.WPFTests.CustomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Augong.WPFTests"
        mc:Ignorable="d"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"   
		d:DataContext="{d:DesignInstance Type=local:CustomWindowViewModel}"
        Title="CustomWindow" Height="450" Width="800">
	<i:Interaction.Triggers>
		<i:EventTrigger EventName="ContentRendered">
			<i:InvokeCommandAction Command="{Binding WindowContentRendered}"/>
		</i:EventTrigger>
	</i:Interaction.Triggers>
	<i:Interaction.Behaviors>
		<local:CustomWindowBehavior WindowData="{Binding WindowData}"/>
	</i:Interaction.Behaviors>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="*"/>
			<RowDefinition Height="auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Background="Transparent">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="auto"/>
			</Grid.ColumnDefinitions>

			<Image Stretch="Fill" Source="/Augong.WPFTests;component/Resource/Mulan.ico" Height="20" Width="20" Grid.Column="0"/>
			<TextBlock HorizontalAlignment="Left"  Text="{Binding Title}" TextWrapping="Wrap" Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center"/>
			<Button HorizontalAlignment="Right"  Grid.Column="2" Margin="0,0,5,0" Command="{Binding CloseCommand}" Visibility="{Binding IsCloseButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource CloseButtonStyle}" Cursor="Hand">
				<i:Interaction.Behaviors>
					<local:DialogButtonBehavior Role="Close"/>
				</i:Interaction.Behaviors>
			</Button>
		</Grid>

		<Grid Grid.Row="1" Margin="10,10,10,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto"/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<Image Height="30" Width="30" Source="{Binding MessageImageSource}" Visibility="{Binding IsImageVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,5,0" Grid.Column="0"/>

			<ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" Grid.Column="1" Visibility="{Binding ContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}" >
				<TextBlock Text="{Binding MessageInfo}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="5,0,0,0" />
			</ScrollViewer>

			<ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" Grid.Column="1" Visibility="{Binding CustomContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
				<ContentPresenter Content="{Binding UserControlInfo}" />
			</ScrollViewer>

		</Grid>

		<Grid Grid.Row="2" Background="#F0F0F0" Visibility="{Binding OkCancelButtonViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Grid HorizontalAlignment="{Binding ButtonLayout}" Margin="10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="auto"/>
				</Grid.ColumnDefinitions>
				<Button Content="{Binding OkButtonContent}" Grid.Column="{Binding OkColumn}" IsDefault="{Binding IsOkDefault}" Width="80" Height="25" Command="{Binding OkCommand}" local:FocusBehavior.IsFocused="{Binding Path=IsOkButtonFocus}" Style="{DynamicResource CommonButtonStyle}" Visibility="{Binding IsOkButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{Binding OkButtonMargin}" AutomationProperties.AutomationId="{Binding OkButtonAutomationID}">
					<i:Interaction.Behaviors>
						<local:DialogButtonBehavior Role="OK"/>
					</i:Interaction.Behaviors>
				</Button>
				<Button Content="{Binding CancelButtonContent}" Grid.Column="{Binding CancelColumn}" IsDefault="{Binding IsCancelDefault}" Width="80" Height="25" Command="{Binding CancelCommand}" local:FocusBehavior.IsFocused="{Binding Path=IsCancelButtonFocus}" Style="{DynamicResource CommonButtonStyle}" Visibility="{Binding IsCancelButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{Binding CancelButtonMargin}" AutomationProperties.AutomationId="{Binding CancelButtonAutomationID}">
					<i:Interaction.Behaviors>
						<local:DialogButtonBehavior Role="Cancel"/>
					</i:Interaction.Behaviors>
				</Button>
			</Grid>
		</Grid>

		<Grid Grid.Row="2" Background="#F0F0F0" Visibility="{Binding YesNoCancelButtonViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
			<WrapPanel  Margin="0,10,0,10" HorizontalAlignment="Center" VerticalAlignment="Center" >
				<Button x:Name="CommonYesButton" Content="Yes" Width="80" Height="25" Command="{Binding OkCommand}" local:FocusBehavior.IsFocused="True" Style="{DynamicResource CommonButtonStyle}" AutomationProperties.AutomationId="{Binding OkButtonAutomationID}">
					<i:Interaction.Behaviors>
						<local:DialogButtonBehavior Role="OK"/>
					</i:Interaction.Behaviors>
				</Button>
				<Button x:Name="CommonNoButton" Content="No"  Width="80" Height="25" Command="{Binding NoCommand}" Style="{DynamicResource CommonButtonStyle}" Margin="20,0,0,0" AutomationProperties.AutomationId="{Binding NoButtonAutomationID}">
					<i:Interaction.Behaviors>
						<local:DialogButtonBehavior Role="OK"/>
					</i:Interaction.Behaviors>
				</Button>
				<Button x:Name="CommonButton" Content="Cancel" Width="80" Height="25" Command="{Binding CancelCommand}" Style="{DynamicResource CommonButtonStyle}" Margin="20,0,0,0" AutomationProperties.AutomationId="{Binding CancelButtonAutomationID}">
					<i:Interaction.Behaviors>
						<local:DialogButtonBehavior Role="Cancel"/>
					</i:Interaction.Behaviors>
				</Button>
			</WrapPanel>
		</Grid>
	</Grid>

</Window>
